  "item": [
    {
      "name": "Auth",
      "description": "Login. O script de Tests salva automaticamente {{token}} e {{userId}} no environment após sucesso.",
      "item": [
        {
          "name": "POST Login (diego)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) {",
                  "        pm.environment.set('token', body.token);",
                  "        console.log('Token salvo no environment.');",
                  "    }",
                  "    if (body.user && body.user.id) {",
                  "        pm.environment.set('userId', body.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"diego\",\n  \"password\": \"Diego#2026\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Recebe {login, password} e devolve {token, user}. O Test script salva token e userId automaticamente no environment."
          }
        },
        {
          "name": "POST Login (bia)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.token) pm.environment.set('token', body.token);",
                  "    if (body.user && body.user.id) pm.environment.set('userId', body.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {"type": "noauth"},
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"bia\",\n  \"password\": \"Bia#2026\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Login alternativo como Bia — útil pra testar isolamento multi-user (Bia não deve ver dados do Diego e vice-versa)."
          }
        }
      ]
